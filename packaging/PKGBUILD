# Arch Linux package for retro-de:  makepkg -si
pkgbase=retro-de
pkgname=('retro-de' 'retro-de-dbus')
pkgver=1.2
pkgrel=1
pkgdesc="Small CDE / Windows 95 style desktop environment for X11"
arch=('x86_64' 'aarch64' 'i686')
url="https://github.com/DobryZiomek/retro-de"
license=('MIT')
depends=('libx11' 'libxft' 'libxinerama' 'libxrandr' 'libxext')
makedepends=('pkgconf')
optdepends=('ttf-dejavu: the default font'
            'xorg-xinit: startx'
            'gcc: building theme modules from C'
            'xscreensaver: screen saver and lock')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!debug')

build() {
	cd "$pkgbase-$pkgver"
	make PREFIX=/usr
}

package_retro-de() {
	optdepends+=('retro-de-dbus: D-Bus for programs that need it, without dbus')
	cd "$pkgbase-$pkgver"
	make install PREFIX=/usr DESTDIR="$pkgdir"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

package_retro-de-dbus() {
	pkgdesc="retro-de's D-Bus session bus stand-in, with notifications and portals"
	depends=('retro-de')
	cd "$pkgbase-$pkgver"
	make install-dbus PREFIX=/usr DESTDIR="$pkgdir"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
