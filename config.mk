# retro-de build settings (included by the Makefile, dwm style).

VERSION = 1.2

# install paths
PREFIX  = /usr/local
BINDIR  = $(PREFIX)/bin
DATADIR = $(PREFIX)/share/retro-de
# theme modules (compiled C themes, NAME.so) and the header to build them
LIBDIR  = $(PREFIX)/lib/retro-de
INCDIR  = $(PREFIX)/include/retro-de
# display managers (LightDM, SDDM, GDM, slim...) list sessions from here;
# leave empty to skip the session file
XSESSIONSDIR = $(PREFIX)/share/xsessions

# pkg-config search path covering OpenBSD (/usr/X11R6), NetBSD (/usr/X11R7,
# pkgsrc), FreeBSD (/usr/local/libdata) and the Linux defaults.
PKG_DIRS = /usr/X11R6/lib/pkgconfig:/usr/X11R7/lib/pkgconfig:/usr/local/libdata/pkgconfig:/usr/local/lib/pkgconfig:/usr/pkg/lib/pkgconfig
PKGCONF  = env PKG_CONFIG_PATH="$$PKG_CONFIG_PATH:$(PKG_DIRS)" pkg-config
PKGS     = x11 xft xinerama xrandr xext

# fallbacks when pkg-config is missing
X_INC_FALLBACK = -I/usr/X11R6/include -I/usr/X11R6/include/freetype2 -I/usr/X11R7/include -I/usr/X11R7/include/freetype2 -I/usr/local/include -I/usr/local/include/freetype2 -I/usr/include/freetype2
X_LIB_FALLBACK = -L/usr/X11R6/lib -L/usr/X11R7/lib -L/usr/local/lib -Wl,-rpath,/usr/X11R6/lib -Wl,-rpath,/usr/X11R7/lib -lXft -lXinerama -lXrandr -lXext -lX11

X_CFLAGS  = `$(PKGCONF) --cflags $(PKGS) 2>/dev/null || echo "$(X_INC_FALLBACK)"`
X_LIBS    = `$(PKGCONF) --libs $(PKGS) 2>/dev/null || echo "$(X_LIB_FALLBACK)"`
XTST_LIBS = `$(PKGCONF) --libs xtst 2>/dev/null || echo "-lXtst"`

# compiler
CC      = cc
AR      = ar
CFLAGS  = -std=c11 -Wall -Wextra -pedantic -O2
LDFLAGS =

# Theme modules are loaded with dlopen(3): the programs export their rui_*
# functions to them (-rdynamic), and glibc before 2.34 keeps dlopen in
# libdl (the BSDs and musl have it in libc; the probe finds out).
EXPORT_FLAGS = -rdynamic
DL_LIBS = `echo 'int main(void){return 0;}' | $(CC) -x c - -ldl -o /dev/null 2>/dev/null && echo -ldl`
# how a theme module is built
SOFLAGS = -fPIC -shared
# wallpapers generated by tools/mkwall at build time
WALL_W  = 1280
WALL_H  = 800
